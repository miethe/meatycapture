exports[`DocumentEditForm > snapshot > matches snapshot with validation errors 1`] = `
<div>
  <form
    aria-label="Edit document form"
    class="document-edit-form"
    id=":rt:-doc-edit-form"
    novalidate=""
  >
    <div
      class="field-container"
    >
      <div
        class="form-field-label-row"
      >
        <label
          class="field-label required"
          for=":rt:-title"
        >
          Title
        </label>
      </div>
      <div
        class="form-field-helper"
        id=":rt:-title-helper"
      >
        The document title displayed in the catalog
      </div>
      <input
        aria-describedby=":rt:-title-error :rt:-title-helper"
        aria-invalid="true"
        aria-required="true"
        class="input-base error"
        id=":rt:-title"
        placeholder="Enter document title..."
        required=""
        type="text"
        value=""
      />
      <div
        class="error-message"
        id=":rt:-title-error"
        role="alert"
      >
        Title is required
      </div>
    </div>
    <div
      class="field-container"
    >
      <div
        class="form-field-label-row"
      >
        <label
          class="field-label"
          for=":rt:-description"
        >
          Description
        </label>
      </div>
      <div
        class="form-field-helper"
        id=":rt:-description-helper"
      >
        Optional notes or description for this document
      </div>
      <textarea
        aria-describedby=":rt:-description-helper"
        class="input-base document-edit-description"
        id=":rt:-description"
        placeholder="Enter document description or notes..."
        rows="4"
      />
    </div>
    <div
      class="document-edit-form-actions"
    >
      <button
        class="button secondary"
        type="button"
      >
        Cancel
      </button>
      <button
        aria-busy="false"
        class="button primary "
        type="submit"
      >
        Save Changes
      </button>
    </div>
  </form>
</div>
`;
