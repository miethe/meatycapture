// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DocumentEditForm > snapshot > matches snapshot in saving state 1`] = `
<div>
  <form
    aria-label="Edit document form"
    class="document-edit-form"
    id=":rs:-doc-edit-form"
    novalidate=""
  >
    <div
      class="field-container"
    >
      <div
        class="form-field-label-row"
      >
        <label
          class="field-label required"
          for=":rs:-title"
        >
          Title
        </label>
      </div>
      <div
        class="form-field-helper"
        id=":rs:-title-helper"
      >
        The document title displayed in the catalog
      </div>
      <input
        aria-describedby=":rs:-title-helper"
        aria-invalid="false"
        aria-required="true"
        class="input-base "
        disabled=""
        id=":rs:-title"
        placeholder="Enter document title..."
        required=""
        type="text"
        value="Test Document Title"
      />
    </div>
    <div
      class="field-container"
    >
      <div
        class="form-field-label-row"
      >
        <label
          class="field-label"
          for=":rs:-description"
        >
          Description
        </label>
      </div>
      <div
        class="form-field-helper"
        id=":rs:-description-helper"
      >
        Optional notes or description for this document
      </div>
      <textarea
        aria-describedby=":rs:-description-helper"
        class="input-base document-edit-description"
        disabled=""
        id=":rs:-description"
        placeholder="Enter document description or notes..."
        rows="4"
      />
    </div>
    <div
      class="document-edit-form-actions"
    >
      <button
        class="button secondary"
        disabled=""
        type="button"
      >
        Cancel
      </button>
      <button
        aria-busy="true"
        class="button primary loading"
        disabled=""
        type="submit"
      >
        <span
          aria-hidden="true"
          class="spinner"
        />
        <span
          class="sr-only"
        >
          Saving...
        </span>
        <span
          aria-hidden="true"
        >
          Saving...
        </span>
      </button>
    </div>
  </form>
</div>
`;

